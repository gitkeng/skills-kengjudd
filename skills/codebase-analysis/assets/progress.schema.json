{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/codebase-analysis/progress.schema.json",
  "title": "Comprehensive codebase analysis progress",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "repository_root", "output_root", "status", "current_phase", "phases", "prior_manifest_loaded", "updated_at"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "output_root": {"type": "string", "minLength": 1},
    "status": {"enum": ["in-progress", "interrupted", "completed", "failed"]},
    "current_phase": {"enum": ["inventory", "architecture", "behavior", "reference-analysis", "debt-specialized", "operations-diagrams", "migration-onboarding", "synthesis", "completed"]},
    "phases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "completed_at", "artifacts"],
        "properties": {
          "id": {"enum": ["inventory", "architecture", "behavior", "reference-analysis", "debt-specialized", "operations-diagrams", "migration-onboarding", "synthesis"]},
          "status": {"enum": ["pending", "in-progress", "completed"]},
          "completed_at": {"type": ["string", "null"]},
          "artifacts": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "prior_manifest_loaded": {"type": "boolean"},
    "updated_at": {"type": "string", "minLength": 1}
  }
}
